# Cloudflare MCP Server Configuration
# Copy to .env and fill in your values

# ============================================================================
# Authentication Method 1: Global API Key (RECOMMENDED for full access)
# ============================================================================
# Provides full account access including zone creation
# Find at: Cloudflare Dashboard → My Profile → API Tokens → View Global API Key

CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_KEY=your-global-api-key

# ============================================================================
# Authentication Method 2: Scoped API Token (Limited access)
# ============================================================================
# Create at: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Requires specific permissions for zone, DNS, tunnel operations

# CLOUDFLARE_API_TOKEN=your-scoped-api-token

# ============================================================================
# Optional Configuration
# ============================================================================
# Cloudflare account ID (auto-detected if using Global API Key)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
